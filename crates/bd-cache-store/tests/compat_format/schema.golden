-- table beads
CREATE TABLE beads (
  id TEXT PRIMARY KEY, phase TEXT, status TEXT, updated_at TEXT,
  row_json TEXT NOT NULL, synced_at TEXT NOT NULL, stale INTEGER NOT NULL DEFAULT 0, membership_known INTEGER, revision TEXT);
-- table edges
CREATE TABLE edges (
  issue_id TEXT NOT NULL, depends_on_id TEXT NOT NULL, type TEXT NOT NULL,
  PRIMARY KEY (issue_id, depends_on_id, type));
-- table journal
CREATE TABLE journal (
  seq INTEGER PRIMARY KEY AUTOINCREMENT, idem_key TEXT NOT NULL UNIQUE, phase TEXT,
  bead TEXT NOT NULL, op TEXT NOT NULL, args_json TEXT NOT NULL, precondition_json TEXT NOT NULL,
  actor TEXT NOT NULL, state TEXT NOT NULL CHECK (state IN ('pending','applied','escalated','resolved')),
  attempts INTEGER NOT NULL DEFAULT 0, last_error TEXT, created_at TEXT NOT NULL, updated_at TEXT NOT NULL,
  announced_at TEXT, applied_at TEXT, applied_epoch INTEGER, last_error_code TEXT, note TEXT, changed INTEGER);
-- table meta
CREATE TABLE meta (key TEXT PRIMARY KEY, value TEXT NOT NULL);
-- table ready_base
CREATE TABLE ready_base (
  scope TEXT PRIMARY KEY, blocked_json TEXT NOT NULL, ready_json TEXT NOT NULL,
  fetched_at TEXT NOT NULL, stale INTEGER NOT NULL DEFAULT 0, indexed INTEGER);
-- table ready_base_blocked
CREATE TABLE ready_base_blocked (
  scope TEXT NOT NULL, bead TEXT NOT NULL, blocked_by_json TEXT NOT NULL,
  PRIMARY KEY (scope, bead)) WITHOUT ROWID;
-- table scope
CREATE TABLE scope (
  name TEXT PRIMARY KEY, kind TEXT NOT NULL DEFAULT 'phase');
-- table scope_member
CREATE TABLE scope_member (
  scope TEXT NOT NULL, bead TEXT NOT NULL, PRIMARY KEY (scope, bead));
-- table sync_state
CREATE TABLE sync_state (
  phase TEXT PRIMARY KEY, last_started_at TEXT, last_ok_at TEXT, last_error TEXT, backend_kind TEXT, endpoint TEXT, replica_id TEXT, journal_seq INTEGER);
-- index beads_membership_unknown
CREATE INDEX beads_membership_unknown ON beads(id) WHERE membership_known IS NULL;
-- index beads_phase
CREATE INDEX beads_phase ON beads(phase, status);
-- index edges_target
CREATE INDEX edges_target ON edges(depends_on_id, type);
-- index journal_applied_epoch
CREATE INDEX journal_applied_epoch ON journal(applied_epoch) WHERE state = 'applied';
-- index journal_applied_unknown
CREATE INDEX journal_applied_unknown ON journal(seq) WHERE state = 'applied' AND applied_epoch IS NULL;
-- index journal_pending
CREATE INDEX journal_pending ON journal(state, bead, seq);
-- index scope_member_bead
CREATE INDEX scope_member_bead ON scope_member(bead);
