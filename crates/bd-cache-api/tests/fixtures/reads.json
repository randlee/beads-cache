{
  "description": "contract §5.3 reads: issues get with its x_cache (scope in label form, pending, rows), NOT_CACHED with miss_timeout_ms 0, ready in (priority, created_at desc, id) order, dependencies list in request order with missing beads, context with the contract version.",
  "world": {
    "beads": [
      {"id": "b1", "priority": 1},
      {"id": "b4", "priority": 1},
      {"id": "b2", "priority": 3},
      {"id": "b3", "priority": 1, "created_at": "2026-10-22T09:00:00Z"},
      {"id": "s1"}
    ],
    "edges": [["s1", "b1", "blocks"], ["s1", "b2", "related"]],
    "sync": ["x"]
  },
  "steps": [
    {
      "name": "issues get",
      "command": "issues get",
      "request": {"id": "s1"},
      "expect": {"ok": true, "data": {"id": "s1", "status": "open", "assignee": "$absent", "revision": "$absent",
        "dependencies": [{"issue_id": "s1", "depends_on_id": "b1", "type": "blocks"}, {"issue_id": "s1", "depends_on_id": "b2", "type": "related"}],
        "x_cache": {"scope": "x", "last_ok_at": "2026-10-23T10:00:00.000Z", "outage": null, "pending": 0,
          "rows": {"s1": {"stale": false, "blocked_by": ["b1"]}}}}}
    },
    {
      "name": "a miss with a zero timeout never asks bd",
      "command": "issues get",
      "request": {"id": "zz", "miss_timeout_ms": 0},
      "expect": {"ok": false, "error": {"code": "BD_CACHE.NOT_CACHED", "kind": "unavailable"}}
    },
    {
      "name": "ready, in its stated order",
      "command": "ready",
      "request": {"scope": "x"},
      "expect": {"ok": true, "data": {"items": [{"id": "b1"}, {"id": "b4"}, {"id": "b3"}, {"id": "b2"}], "has_more": false,
        "x_cache": {"scope": "x", "basis": {"kind": "cached", "fetched_at": "$any", "stale": false}, "locally_adjusted": false,
          "read_fallback": null, "read_fallback_error": null, "missing_rows": [], "outage": null}}}
    },
    {
      "name": "ready with a limit",
      "command": "ready",
      "request": {"scope": "x", "limit": 2, "sort": "priority"},
      "expect": {"ok": true, "data": {"items": [{"id": "b1"}, {"id": "b4"}], "has_more": true}}
    },
    {
      "name": "ready needs a scope",
      "command": "ready",
      "request": {},
      "expect": {"ok": false, "error": {"code": "BD_CACHE.SCOPE_UNKNOWN"}}
    },
    {
      "name": "dependencies list",
      "command": "dependencies list",
      "request": {"issue_id": ["zz", "s1", "b1"], "type": ["blocks"]},
      "expect": {"ok": true, "data": {"items": [{"issue_id": "s1", "depends_on_id": "b1", "type": "blocks"}], "missing": ["zz"],
        "x_cache": {"outage": null, "not_cached": ["zz"]}}}
    },
    {
      "name": "context",
      "command": "context",
      "request": {},
      "expect": {"ok": true, "data": {"bd_version": "$any", "database": "beads", "project_id": "proj-1",
        "capabilities": ["issues.get", "issues.list", "ready.list", "dependencies.list", "issues.update", "issues.close", "dependencies.add"],
        "x_cache": {"cache_path": "/repo/.bd-cache/beads.bd-cache.sqlite3", "contract_version": "0.2.0", "store_schema_version": 3,
          "bd_schema_sha256": "$any", "bd_schema_version": "$any", "model_current": true}}}
    },
    {
      "name": "cache scopes",
      "command": "cache scopes",
      "request": {},
      "expect": {"ok": true, "data": {"scopes": [{"scope": "x", "configured": true, "on_demand": false,
        "last_ok_at": "2026-10-23T10:00:00.000Z", "last_error": null, "alert": null, "beads": 5}]}}
    }
  ]
}
