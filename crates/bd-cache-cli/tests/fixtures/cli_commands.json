{
  "description": "REQ-BDC-0801, contract §5.2 and §6: every command of both surfaces, typed as argv, reaches its bd-cache-api operation through run() and gets its envelope. The world and the matcher are b-2's (crates/bd-cache-api/tests/fixtures/README.md); a step gives argv instead of a request, and a bd_update step changes a row in the fake bd between two commands.",
  "world": {
    "beads": [
      {"id": "b1", "status": "in_progress", "assignee": "dev", "priority": 1},
      {"id": "b2", "priority": 3},
      {"id": "b4"},
      {"id": "s1"}
    ],
    "edges": [["s1", "b1", "blocks"], ["s1", "b2", "related"]],
    "sync": ["x"]
  },
  "steps": [
    {"name": "issues get", "command": "issues get", "argv": ["issues", "get", "s1", "--miss-timeout-ms", "0"],
      "expect": {"ok": true, "data": {"id": "s1", "x_cache": {"scope": "phase-x", "pending": 0, "rows": {"s1": {"stale": false, "blocked_by": ["b1"]}}}}}},
    {"name": "issues list pages with an explicit limit", "command": "issues list",
      "argv": ["issues", "list", "--scope", "phase-x", "--sort", "priority", "--limit", "1", "--label", "phase-x"],
      "expect": {"ok": true, "data": {"items": [{"id": "b1"}], "has_more": true, "next_cursor": "$any", "x_cache": {"scope": "phase-x"}}}},
    {"name": "issues list filters by status", "command": "issues list",
      "argv": ["issues", "list", "--scope", "x", "--status", "in_progress"],
      "expect": {"ok": true, "data": {"items": [{"id": "b1"}], "has_more": false}}},
    {"name": "ready", "command": "ready", "argv": ["ready", "--scope", "x", "--sort", "priority"],
      "expect": {"ok": true, "data": {"items": [{"id": "b4"}, {"id": "b2"}], "has_more": false,
        "x_cache": {"basis": {"kind": "cached"}, "read_fallback": null}}}},
    {"name": "dependencies list", "command": "dependencies list",
      "argv": ["dependencies", "list", "--issue-id", "zz", "s1", "--type", "blocks"],
      "expect": {"ok": true, "data": {"items": [{"issue_id": "s1", "depends_on_id": "b1", "type": "blocks"}], "missing": ["zz"]}}},
    {"name": "context", "command": "context", "argv": ["context"],
      "expect": {"ok": true, "data": {"database": "beads", "project_id": "proj-1", "repo_root": "/repo", "beads_dir": "/repo/.beads",
        "x_cache": {"cache_path": "/repo/.bd-cache/beads.bd-cache.sqlite3", "contract_version": "1.0.0", "store_schema_version": 3}}}},
    {"name": "issues update", "command": "issues update",
      "argv": ["issues", "update", "b2", "--actor", "san", "--idempotency-key", "k1", "--status", "in_progress", "--add-label", "hot",
        "--set-metadata", "{\"lane\": \"a\"}", "--expected-status", "open"],
      "expect": {"ok": true, "data": {"issue": {"id": "b2", "status": "in_progress", "labels": ["phase-x", "hot"], "metadata": {"lane": "a"}}, "changed": true,
        "x_cache": {"seq": 1, "state": "pending", "duplicate": false, "idempotency_key": "k1"}}}},
    {"name": "issues close", "command": "issues close",
      "argv": ["issues", "close", "s1", "--actor", "san", "--idempotency-key", "k2", "--reason", "done"],
      "expect": {"ok": true, "data": {"issue": {"id": "s1", "status": "closed"}, "already_closed": false, "x_cache": {"seq": 2, "state": "pending"}}}},
    {"name": "dependencies add", "command": "dependencies add",
      "argv": ["dependencies", "add", "b2", "b1", "--type", "blocks", "--actor", "san", "--idempotency-key", "k3"],
      "expect": {"ok": true, "data": {"added": [{"issue_id": "b2", "depends_on_id": "b1", "type": "blocks"}], "x_cache": {"seq": 3}}}},
    {"name": "cache status", "command": "cache status", "argv": ["cache", "status"],
      "expect": {"ok": true, "data": {"cache_path": "/repo/.bd-cache/beads.bd-cache.sqlite3", "project": {"database": "beads", "project_id": "proj-1"},
        "journal": {"pending": 3, "applied": 0, "escalated": 0, "resolved": 0}, "escalated": []}}},
    {"name": "cache health", "command": "cache health", "argv": ["cache", "health"],
      "expect": {"ok": true, "data": {"state": "ok", "outage": null, "open_work": {"pending": 3, "escalated_unannounced": 0}, "probe": null}}},
    {"name": "cache health --probe", "command": "cache health", "argv": ["cache", "health", "--probe"],
      "expect": {"ok": true, "data": {"state": "ok", "probe": {"model_current": true, "rebuilt": false}}}},
    {"name": "cache scopes", "command": "cache scopes", "argv": ["cache", "scopes"],
      "expect": {"ok": true, "data": {"scopes": [{"scope": "phase-x", "configured": true, "on_demand": false, "beads": 4}]}}},
    {"name": "cache journal list --state pending", "command": "cache journal list", "argv": ["cache", "journal", "list", "--state", "pending"],
      "expect": {"ok": true, "data": {"entries": [{"seq": 1}, {"seq": 2}, {"seq": 3}]}}},
    {"name": "cache flush", "command": "cache flush", "argv": ["cache", "flush", "--start-gate-ms", "20000", "--deadline-ms", "25000"],
      "expect": {"ok": true, "data": {"busy": false, "applied": [1, 2, 3], "escalated": [], "outage": null}}},
    {"name": "cache journal get by seq", "command": "cache journal get", "argv": ["cache", "journal", "get", "1"],
      "expect": {"ok": true, "data": {"entry": {"seq": 1, "state": "applied", "args": {"status": "in_progress", "add_labels": ["hot"], "metadata": {"set": {"lane": "a"}}}}}}},
    {"name": "cache journal get by key", "command": "cache journal get", "argv": ["cache", "journal", "get", "--idempotency-key", "k2"],
      "expect": {"ok": true, "data": {"entry": {"seq": 2, "op": "close", "state": "applied"}}}},
    {"name": "cache refresh issues", "command": "cache refresh issues", "argv": ["cache", "refresh", "issues", "b2", "b1"],
      "expect": {"ok": true, "data": {"issues": [{"id": "b2", "status": "in_progress"}, {"id": "b1"}], "x_cache": {"rows": {"b2": {"stale": false}}}}}},
    {"name": "cache refresh scopes", "command": "cache refresh scopes", "argv": ["cache", "refresh", "scopes", "x"],
      "expect": {"ok": true, "data": {"failed": 0, "results": [{"scope": "phase-x", "error": null, "report": {"rebuilt": false}}]}}},
    {"name": "a write whose guard holds when journaled", "command": "issues update",
      "argv": ["issues", "update", "b4", "--actor", "san", "--idempotency-key", "k4", "--assignee", "san", "--expected-status", "open"],
      "expect": {"ok": true, "data": {"x_cache": {"seq": 4, "state": "pending"}}}},
    {"name": "bd moves b4 on", "bd_update": {"id": "b4", "status": "in_progress"}},
    {"name": "the flush escalates the guard miss", "command": "cache flush", "argv": ["cache", "flush"],
      "expect": {"ok": true, "data": {"applied": [], "escalated": [{"seq": 4, "bead": "b4", "op": "update", "actor": "san", "scope": "phase-x",
        "reason": {"code": "BD_CACHE.PRECONDITION"}}]}}},
    {"name": "cache journal list (escalated by default)", "command": "cache journal list", "argv": ["cache", "journal", "list"],
      "expect": {"ok": true, "data": {"entries": [{"seq": 4, "state": "escalated", "last_error": {"code": "BD_CACHE.PRECONDITION"}, "note": null}]}}},
    {"name": "cache journal announce", "command": "cache journal announce", "argv": ["cache", "journal", "announce", "4"],
      "expect": {"ok": true, "data": {"entry": {"seq": 4, "announced_at": "$any"}, "already_announced": false}}},
    {"name": "nothing is left unannounced", "command": "cache journal list", "argv": ["cache", "journal", "list", "--unannounced"],
      "expect": {"ok": true, "data": {"entries": []}}},
    {"name": "cache journal resolve", "command": "cache journal resolve", "argv": ["cache", "journal", "resolve", "4", "--note", "fixed by hand", "--actor", "lead"],
      "expect": {"ok": true, "data": {"entry": {"seq": 4, "state": "resolved", "note": "$any", "last_error": {"code": "BD_CACHE.PRECONDITION"}}, "already_resolved": false}}},
    {"name": "cache evict", "command": "cache evict", "argv": ["cache", "evict", "--scope", "phase-x"],
      "expect": {"ok": true, "data": {"scope": "phase-x", "beads_deleted": 4, "out_of_scope_swept": "$any"}}},
    {"name": "an evicted scope is not served", "command": "issues list", "argv": ["issues", "list", "--scope", "x"],
      "expect": {"ok": false, "error": {"code": "BD_CACHE.SCOPE_UNKNOWN", "kind": "conflict"}}},
    {"name": "cache tick without a team is refused, as data", "command": "cache tick", "argv": ["cache", "tick", "--budget-ms", "1000"],
      "expect": {"ok": true, "data": {"outcome": "refused", "refused": [{"code": "BD_CACHE.TICK_MISSING_TEAM", "message": "$any"}]}}}
  ]
}
