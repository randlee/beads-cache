42:async fn inherited_deadline_includes_the_blocking_cache_claim_and_starts_no_bd_after_expiry() {
43:    let world = World::new();
44:    let cache = world.shared(vec![]);
45:    let (held, holding) = mpsc::channel();
46:    let (release, released) = mpsc::channel::<()>();
47:    let holder = {
48:        let cache = std::sync::Arc::clone(&cache);
49:        std::thread::spawn(move || {
50:            let until = Instant::now() + Duration::from_secs(5);
51:            let guard = loop {
52:                if let Ok(guard) = cache.try_lock() {
53:                    break guard;
54:                }
55:                assert!(Instant::now() < until);
56:                std::thread::yield_now();
57:            };
58:            held.send(()).unwrap();
59:            let _ = released.recv_timeout(Duration::from_secs(5));
60:            drop(guard);
61:        })
62:    };
63:    holding.recv_timeout(Duration::from_secs(5)).unwrap();
64:    let before = world.bd.calls().len();
65:    let payload = bd_cache_sync::BuiltinPayload::default();
66:    let budget = bd_cache_sync::Budget::new(&*world.clock, &payload.budget);
67:    let start = Instant::now();
68:    let result = bd_cache_sync::run_builtin_until(
69:        &cache,
70:        &payload,
71:        &world.ctx(),
72:        bd_cache_sync::new_run_id(9).unwrap(),
73:        sc_beads::Deadline::at(start + Duration::from_millis(50)),
74:        budget,
75:    )
76:    .await;
77:    let elapsed = start.elapsed();
78:    drop(release);
79:    common::join_thread(holder).unwrap();
80:    assert!(result.unwrap_err().detail().contains("deadline expired"));
81:    assert!(elapsed < Duration::from_millis(150));
82:    assert_eq!(
83:        world.bd.calls().len(),
84:        before,
85:        "no detached preparation starts a late bd call"
86:    );
87:    let expired = bd_cache_sync::run_builtin_until(
88:        &cache,
89:        &payload,
90:        &world.ctx(),
91:        bd_cache_sync::new_run_id(10).unwrap(),
92:        sc_beads::Deadline::at(Instant::now().checked_sub(Duration::from_secs(1)).unwrap()),
93:        budget,
94:    )
95:    .await;
96:    assert!(expired.is_err());
97:    assert_eq!(world.bd.calls().len(), before);
98:}

