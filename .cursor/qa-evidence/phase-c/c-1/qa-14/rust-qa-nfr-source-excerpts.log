325:async fn migrated_incremental_sync_of_1000_beads_is_under_one_second() {
326:    use bd_cache_sync::{ScheduleSet, StopFlag};
327:    let repo = common::repo::Repo::new(vec![common::label_scope("area", "area")]);
328:    for n in 0..1_000 {
329:        let mut row = bead(&format!("b{n}"));
330:        row.labels = vec!["area".into()];
331:        repo.bd.insert(row);
332:    }
333:    repo.schedules()
334:        .set(&ScheduleSet {
335:            expr: "0 * * * * *".into(),
336:            budget_ms: None,
337:            hook_reserve_ms: Some(0),
338:            post_sync: None,
339:            python: None,
340:            env: vec![],
341:        })
342:        .await
343:        .unwrap();
344:    repo.clock.advance(Duration::from_secs(60));
345:    repo.cron_clock.advance(chrono::Duration::seconds(60));
346:    assert_eq!(
347:        repo.schedules()
348:            .cron_run_once(StopFlag::new())
349:            .await
350:            .unwrap()
351:            .ran[0]
352:            .outcome,
353:        "ok"
354:    );
355:    repo.clock.advance(Duration::from_secs(1));
356:    let mut changed = repo.bd.row("b17").unwrap();
357:    changed.updated_at = repo.clock.now_utc().as_str().to_owned();
358:    changed.title = "incremental update".into();
359:    repo.bd.insert(changed);
360:    repo.clock.advance(Duration::from_secs(59));
361:    repo.cron_clock.advance(chrono::Duration::seconds(60));
362:    repo.bd.clear_calls();
363:    let start = Instant::now();
364:    let run = repo
365:        .schedules()
366:        .cron_run_once(StopFlag::new())
367:        .await
368:        .unwrap();
369:    let elapsed = start.elapsed();
370:    assert!(
371:        repo.bd.calls().iter().any(|call| matches!(
372:            call,
373:            sc_beads::testing::FakeCall::ListScope { since: Some(_), .. }
374:        )),
375:        "qualification must actually use an incremental cursor"
376:    );
377:    assert_eq!(run.ran[0].outcome, "ok");
378:    assert_eq!(
379:        repo.cache
380:            .lock()
381:            .unwrap()
382:            .get(&sc_beads::testing::id("b17"), None)
383:            .unwrap()
384:            .row
385:            .bead
386:            .title,
387:        "incremental update"
388:    );
389:    eprintln!("NFR-BDC-0003 migrated scheduled incremental sync of 1000-bead scope: {elapsed:?}");
390:    assert!(
391:        elapsed < Duration::from_secs(1),
392:        "incremental sync exceeded one second: {elapsed:?}"
393:    );
