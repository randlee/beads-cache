<urn:beads-cache:finding:QA-C2-001> triage:id "QA-C2-001" ; triage:sprint "c-2" ; triage:severity "important" ; triage:location "scripts/consumer_checks.py:391" ; triage:source "qa-3 owning reviewer fenced JSON" ; triage:status "open" ; triage:record "{\"category\": \"portability\", \"evidence\": \"Current60670540 keeps native crate sources, Cargo.toml/Cargo.lock, runtime/pin.toml byte-identical to QA2. Windows Job constructor and termination/accounting/close AST are unchanged. scripts/consumer_checks.py391 and473 still send CTRL_BREAK_EVENT; pinned sc-runtime0.1.1 is still CtrlC-only. Prior actual Windows qualification41571204095 failed abnormal termination3221225786 followed by WinError32; no new successful Windows stop qualification or public runtime fix is present. POSIX fixture cleanup improvements do not change this upstream Windows signal contract.\", \"file\": \"scripts/consumer_checks.py\", \"id\": \"QA-C2-001\", \"issue\": \"Windows acceptance still sends CTRL_BREAK_EVENT to the unchanged published runtime which only registers CtrlC, so owned graceful Windows shutdown remains blocked. The blocked-hook stop at line473 repeats the same path.\", \"line\": 391, \"recommendation\": \"Obtain and adopt an approved public upstream graceful Windows stop path that supports the isolated process-group acceptance contract; validate clean exit, actual worker/readiness joins, descendant reap, ownership release and restart in hosted Windows acceptance. Preserve the original zero-exit/cleanup assertions. Do not accept abnormal termination, skip Windows, add an unapproved competing signal handler, or claim dropping a task cancels it. This is a published-runtime compatibility blocker, not a request for workaround exploration.\", \"reviewer\": \"rust-qa-agent\", \"severity\": \"important\", \"status\": \"open\", \"upstream_blocked\": true}" .
<urn:beads-cache:finding:QA-C2-001> triage:occurrence "c-4@e7bafc2e5bdda1bf480823c7dd3ac73d0e16b702 qa-1" ; triage:occurrenceRecord "{\"category\": \"portability\", \"evidence\": \"Current stop391 and blocked-hook473 use CTRL_BREAK_EVENT. Independently read registry sc-runtime0.1.1 shutdown.rs61/96/131-133: CtrlC only. Existing recorded Windows41571204095 exited3221225786/WinError32; no new Windows execution or successful current four-platform matrix is claimed. Correlates QA-C2-001.\", \"file\": \"scripts/consumer_checks.py\", \"id\": \"QA-C2-001\", \"issue\": \"Required Windows graceful shutdown qualification remains incompatible with the pinned runtime: acceptance sends CTRL_BREAK_EVENT while sc-runtime0.1.1 listens only for CtrlC.\", \"line\": 391, \"recommendation\": \"Adopt an authorized public upstream Windows graceful-stop API and rerun hosted Windows acceptance with existing zero-exit, descendant reap, lock release and restart assertions intact.\", \"reviewer\": \"rust-qa-agent\", \"reviewer_records\": [{\"category\": \"portability\", \"evidence\": \"Current stop391 and blocked-hook473 use CTRL_BREAK_EVENT. Independently read registry sc-runtime0.1.1 shutdown.rs61/96/131-133: CtrlC only. Existing recorded Windows41571204095 exited3221225786/WinError32; no new Windows execution or successful current four-platform matrix is claimed. Correlates QA-C2-001.\", \"file\": \"scripts/consumer_checks.py\", \"id\": \"QA-C2-001\", \"issue\": \"Required Windows graceful shutdown qualification remains incompatible with the pinned runtime: acceptance sends CTRL_BREAK_EVENT while sc-runtime0.1.1 listens only for CtrlC.\", \"line\": 391, \"recommendation\": \"Adopt an authorized public upstream Windows graceful-stop API and rerun hosted Windows acceptance with existing zero-exit, descendant reap, lock release and restart assertions intact.\", \"reviewer\": \"rust-qa-agent\", \"severity\": \"important\"}, {\"adr\": \"ADR-BDC-0016\", \"description\": \"Inherited Windows graceful-stop contract remains open: installed procedure sends CTRL_BREAK while pinned runtime0.1.1 handles CtrlC only. The adopted runtime must preserve existing shutdown semantics; canonical packaging cannot exempt the production application.\", \"file\": \"docs/plans/phase-c/evidence/c-2-application.md\", \"id\": \"QA-C2-001\", \"line\": 168, \"remediation\": \"Obtain the owning upstream/parent correction and repeat unchanged Windows installed acceptance. Do not replace the signal/skip the platform or claim macOS evidence covers Windows.\", \"reviewer\": \"arch-qa\", \"rule\": \"RULE-ADR-CODE\", \"severity\": \"BLOCKING\"}, {\"evidence\": \"Current consumer_checks.py:385-396 creates a Windows process group and sends CTRL_BREAK_EVENT with zero-exit and finite elapsed assertions. Independently inspected published sc-runtime0.1.1 shutdown.rs:60-64,94-102,126-135: Signals stores only CtrlC, install calls ctrl_c only, wait polls ctrl_c only. REQ-DAEMON-0004 acceptance evidence explicitly keeps QA-C2-001 open. No Windows execution or new platform success is claimed by this read-only reviewer.\", \"file\": \"scripts/consumer_checks.py\", \"id\": \"QA-C2-001\", \"issue\": \"The required Windows graceful-stop path sends CTRL_BREAK_EVENT, but the pinned runtime only installs and waits for CtrlC. That event cannot drive the required drain, worker/readiness joins and supervised child cleanup through the published signal path. Existing recorded abnormal exit remains unresolved.\", \"line\": 391, \"recommendation\": \"Keep the existing owner ID open and consume an approved published runtime Windows stop correction that handles the acceptance event before lock/bind. Rerun the unchanged hosted Windows graceful-stop, exit-zero, descendant-reap, SQLite ownership-release and same-root restart assertions. Do not change the signal or weaken assertions to manufacture green CI.\", \"reviewer\": \"rust-service-hardening-agent\", \"severity\": \"important\", \"topic\": \"graceful_shutdown\"}], \"severity\": \"BLOCKING\"}" .
