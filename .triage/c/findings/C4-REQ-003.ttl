<urn:beads-cache:finding:C4-REQ-003> triage:id "C4-REQ-003" ; triage:sprint "c-4" ; triage:severity "Blocking" ; triage:location "scripts/check_release_candidate.py:124; scripts/check_release_candidate.py:131; scripts/check_release_candidate.py:150; scripts/check_release_candidate.py:196; scripts/test_release_candidate.py:72" ; triage:source "C4 QA1 actual parent-spawned reviewer fenced JSON" ; triage:status "closed" ; triage:record "{\"category\": \"acceptance-gap\", \"compliance_result\": \"non-compliant\", \"id\": \"C4-REQ-003\", \"issue\": \"pack stamps current git HEAD onto binaries and wheels supplied through arbitrary directories, without source identity from their producer. validate compares a wheel only against newly stamped outer receipt plus platform/version/METADATA. A same-version wheel or executable built from a different commit can therefore be relabeled current; existing mixed-wheel test changes expected receipt commit, not a real foreign-source artifact. Controlled CI currently builds from correct checkout, but the rerunnable candidate contract does not enforce the required mixed-source negative.\", \"recommendation\": \"Bind candidate inputs to trustworthy same-source build provenance, and add a negative for actual same-version foreign-source artifact substitution. Preserve canonical kit ownership; fix consumer extension/build seam rather than editing generated kit.\", \"required_correction\": \"Bind candidate inputs to trustworthy same-source build provenance, and add a negative for actual same-version foreign-source artifact substitution. Preserve canonical kit ownership; fix consumer extension/build seam rather than editing generated kit.\", \"reviewer\": \"req-qa\", \"reviewer_records\": [{\"category\": \"acceptance-gap\", \"compliance_result\": \"non-compliant\", \"id\": \"C4-REQ-003\", \"issue\": \"pack stamps current git HEAD onto binaries and wheels supplied through arbitrary directories, without source identity from their producer. validate compares a wheel only against newly stamped outer receipt plus platform/version/METADATA. A same-version wheel or executable built from a different commit can therefore be relabeled current; existing mixed-wheel test changes expected receipt commit, not a real foreign-source artifact. Controlled CI currently builds from correct checkout, but the rerunnable candidate contract does not enforce the required mixed-source negative.\", \"required_correction\": \"Bind candidate inputs to trustworthy same-source build provenance, and add a negative for actual same-version foreign-source artifact substitution. Preserve canonical kit ownership; fix consumer extension/build seam rather than editing generated kit.\", \"reviewer\": \"req-qa\", \"severity\": \"Blocking\", \"source_refs\": [\"docs/plans/phase-c/sprint-c-4-release-qualification.md:88\", \"docs/plans/phase-c/sprint-c-4-release-qualification.md:101\", \"docs/requirements.md:985\"], \"target_refs\": [\"scripts/check_release_candidate.py:124\", \"scripts/check_release_candidate.py:131\", \"scripts/check_release_candidate.py:150\", \"scripts/check_release_candidate.py:196\", \"scripts/test_release_candidate.py:72\"]}, {\"adr\": null, \"description\": \"Candidate source identity is stamped from packaging checkout onto arbitrary --bin-dir/--wheel-dir inputs. validate checks the new outer/archive receipt and wheel version/platform/hash, with no producer source binding. Thus same-version foreign-source inputs can be relabeled current. Controlled workflow building the correct checkout does not enforce the rerunnable mixed-source negative. Correlates req-qa C4-REQ-003.\", \"file\": \"scripts/check_release_candidate.py\", \"id\": \"C4-REQ-003\", \"line\": 134, \"remediation\": \"Bind packaged inputs to trustworthy same-source producer provenance and add a genuine same-version foreign-artifact substitution negative through consumer-owned extensions/build seam. Preserve canonical kit ownership; no hand-edited vendored workflow.\", \"reviewer\": \"arch-qa\", \"rule\": \"RULE-GATE\", \"severity\": \"BLOCKING\"}, {\"class\": \"boundary_violation\", \"evidence\": \"pack accepts --bin-dir/--wheel-dir and records commit() from the packaging checkout alongside hashes freshly computed over those supplied files. validate compares outer/archive copies of that same newly stamped receipt; wheel validation checks version/abi3/platform/METADATA but no producer source identity. Therefore a foreign-source same-version binary/wheel can receive the current checkout commit and pass these source checks. Workflow builds from the proper checkout but that procedural ordering does not enforce the rerunnable mixed-source negative. This is not an allegation that actual 652 artifacts were foreign. Independently agrees with req-qa and arch-qa C4-REQ-003.\", \"file\": \"scripts/check_release_candidate.py\", \"id\": \"C4-REQ-003\", \"issue\": \"The candidate packaging boundary promotes arbitrary same-version input artifacts into current-source identity without a producer source binding.\", \"justification_check\": \"Missing requirement/ADR justification\", \"line\": 134, \"recommendation\": \"Bind all packaged binaries and the wheel to trustworthy same-source producer provenance at the consumer-owned build/packaging seam and fail closed on a same-version foreign-source substitution. Keep canonical sc-publish copied assets unchanged. Correlate with existing C4-REQ-003 rather than counting another defect.\", \"related_artifacts\": [\"docs/plans/phase-c/sprint-c-4-release-qualification.md\", \"scripts/check_release_candidate.py\", \".github/workflows/release-qualification.yml\", \"scripts/test_release_candidate.py\"], \"reviewer\": \"ruthless-boundary-qa\", \"severity\": \"critical\"}], \"severity\": \"Blocking\", \"source_refs\": [\"docs/plans/phase-c/sprint-c-4-release-qualification.md:88\", \"docs/plans/phase-c/sprint-c-4-release-qualification.md:101\", \"docs/requirements.md:985\"], \"target_refs\": [\"scripts/check_release_candidate.py:124\", \"scripts/check_release_candidate.py:131\", \"scripts/check_release_candidate.py:150\", \"scripts/check_release_candidate.py:196\", \"scripts/test_release_candidate.py:72\"]}" .
