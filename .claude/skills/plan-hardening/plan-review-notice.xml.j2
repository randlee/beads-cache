---
name: plan-review-notice
version: 1.1.0
description: durable notice that one in-process (background-agent) plan review round ran, so plan activity stays observable in ATM search.
format: xml
required_variables:
  - phase
  - reviewer
  - round_index
  - pr_number
  - branch
  - commit
  - verdict
  - summary
metadata:
  type: plan-review-notice
  tags:
    - stage:plan
  workflow:
    scope:
      kind: phase
      variable: phase
    state: plan-review-notice
    stage: plan
    transition: notice
    iteration_variable: round_index
---
<plan-review-notice phase="{{ phase }}" reviewer="{{ reviewer }}" round="{{ round_index }}" verdict="{{ verdict }}">
  <pr-number><![CDATA[{{ pr_number | string | cdata_escape }}]]></pr-number>
  <branch><![CDATA[{{ branch | string | cdata_escape }}]]></branch>
  <commit><![CDATA[{{ commit | string | cdata_escape }}]]></commit>
  <summary><![CDATA[
{{ summary | string | cdata_escape }}
  ]]></summary>
  <note><![CDATA[Informational only. No reply or task action is required.]]></note>
</plan-review-notice>
